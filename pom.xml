<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ch.ubique.uetlib</groupId>
        <artifactId>uetlib-parent</artifactId>
        <version>2026.11.0</version>
        <relativePath/>
    </parent>

    <artifactId>uetlib-storage-spring-boot</artifactId>
    <version>4.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>uetlib-storage-spring-boot</name>
    <description>Spring Boot integration for uetlib storage.</description>
    <url>https://github.com/UbiqueInnovation/uetlib-storage-spring-boot</url>
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <organization>
        <name>Ubique Innovation AG</name>
        <url>https://www.ubique.ch</url>
    </organization>
    <developers>
        <developer>
            <name>Ubique Innovation AG</name>
            <organization>Ubique Innovation AG</organization>
            <organizationUrl>https://www.ubique.ch</organizationUrl>
        </developer>
    </developers>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>ch.ubique.uetlib</groupId>
                <artifactId>uetlib-testcontainers-postgresql</artifactId>
                <version>3.0.0</version>
            </dependency>
            <dependency>
                <groupId>ch.ubique.uetlib</groupId>
                <artifactId>uetlib-storage</artifactId>
                <version>3.0.0</version>
            </dependency>
            <dependency>
                <groupId>ch.ubique.uetlib</groupId>
                <artifactId>uetlib-spring-boot</artifactId>
                <version>4.0.0</version>
            </dependency>
            <dependency>
                <groupId>ch.ubique.uetlib</groupId>
                <artifactId>uetlib-core</artifactId>
                <version>3.0.0</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>ch.ubique.uetlib</groupId>
            <artifactId>uetlib-core</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.ubique.uetlib</groupId>
            <artifactId>uetlib-spring-boot</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.ubique.uetlib</groupId>
            <artifactId>uetlib-storage</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>net.bytebuddy</groupId>
            <artifactId>byte-buddy</artifactId>
        </dependency>

        <!-- Only needed by the explicitly configured S3 proxy adapter. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- For testing storage clients -->
        <dependency>
            <groupId>ch.ubique.uetlib</groupId>
            <artifactId>uetlib-testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>



    <scm child.scm.url.inherit.append.path="false" child.scm.connection.inherit.append.path="false" child.scm.developerConnection.inherit.append.path="false">
        <connection>scm:git:https://github.com/UbiqueInnovation/uetlib-storage-spring-boot.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/UbiqueInnovation/uetlib-storage-spring-boot.git</developerConnection>
        <url>https://github.com/UbiqueInnovation/uetlib-storage-spring-boot</url>
    </scm>
</project>
