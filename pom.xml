<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ch.ubique</groupId>
        <artifactId>uetlib-bom</artifactId>
        <version>1.0.0-alpha.9</version>
    </parent>

    <artifactId>uetlib-storage-spring</artifactId>
    <version>2.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <dependencies>
        <!-- uetlib modules -->
        <dependency>
            <groupId>ch.ubique</groupId>
            <artifactId>uetlib-spring</artifactId>
            <version>1.0.0-alpha.5</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!-- RetryTemplate and @Retryable, convenient way for retrying -->
        <dependency>
            <groupId>org.springframework.retry</groupId>
            <artifactId>spring-retry</artifactId>
            <version>2.0.10</version>
        </dependency>

        <!-- External storage clients -->
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-storage-blob</artifactId>
            <version>12.28.1</version>
        </dependency>
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
            <version>8.5.13</version>
        </dependency>

        <!-- Reflections -->
        <dependency>
            <groupId>org.reflections</groupId>
            <artifactId>reflections</artifactId>
            <version>0.10.2</version>
        </dependency>

        <!-- For testing storage clients -->
        <dependency>
            <groupId>ch.ubique</groupId>
            <artifactId>uetlib-testcontainers-postgresql</artifactId>
            <version>1.0.0-alpha.8</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>ch.ubique</groupId>
            <artifactId>uetlib-test</artifactId>
            <version>1.0.0-alpha.8</version>
        </dependency>

        <dependency>
            <groupId>net.bytebuddy</groupId>
            <artifactId>byte-buddy</artifactId>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <type>pom</type>
                <scope>import</scope>
                <version>${org.springframework.boot.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>