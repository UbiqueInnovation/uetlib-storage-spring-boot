<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ch.ubique</groupId>
        <artifactId>uetlib-parent</artifactId>
        <version>2026.07.3</version>
    </parent>

    <artifactId>uetlib-storage-spring-boot</artifactId>
    <version>3.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <!-- westemeyer version config -->
        <westemeyer-version-package-name>ch.ubique.backend.storage.spring.boot.version</westemeyer-version-package-name>

        <!-- Sonar -->
        <sonar.projectName>uetlib-storage-spring-boot</sonar.projectName>
        <sonar.coverage.module>uetlib-storage-spring-boot</sonar.coverage.module>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>ch.ubique</groupId>
                <artifactId>uetlib-testcontainers-postgresql</artifactId>
                <version>2.1.0</version>
            </dependency>
            <dependency>
                <groupId>ch.ubique</groupId>
                <artifactId>uetlib-storage</artifactId>
                <version>2.2.0</version>
            </dependency>
            <dependency>
                <groupId>ch.ubique</groupId>
                <artifactId>uetlib-spring-boot</artifactId>
                <version>2.2.2</version>
            </dependency>
            <dependency>
                <groupId>ch.ubique</groupId>
                <artifactId>uetlib-core</artifactId>
                <version>2.3.3</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>ch.ubique</groupId>
            <artifactId>uetlib-core</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.ubique</groupId>
            <artifactId>uetlib-spring-boot</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.ubique</groupId>
            <artifactId>uetlib-storage</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>net.bytebuddy</groupId>
            <artifactId>byte-buddy</artifactId>
        </dependency>

        <!-- For testing storage clients -->
        <dependency>
            <groupId>ch.ubique</groupId>
            <artifactId>uetlib-testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <repositories>
        <repository>
            <id>ubique-artifactory</id>
            <name>backend</name>
            <url>https://artifactory.ubique.ch/artifactory/backend</url>
        </repository>
        <repository>
            <id>ubique-artifactory-virtual</id>
            <name>ubique</name>
            <url>https://artifactory.ubique.ch/artifactory/ubique</url>
        </repository>
        <repository>
            <id>osgeo</id>
            <name>Open Source Geospatial Foundation Repository</name>
            <url>https://repo.osgeo.org/repository/release/</url>
        </repository>
    </repositories>

    <scm child.scm.url.inherit.append.path="false">
        <url>https://github.com/UbiqueInnovation/uetlib-storage-spring-boot</url>
    </scm>
</project>